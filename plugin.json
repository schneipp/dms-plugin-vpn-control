{
    "id": "vpnControl",
    "name": "VPN Control",
    "description": "Connect and disconnect NetworkManager VPN and WireGuard connections from the bar. Shows the active tunnel at a glance.",
    "version": "1.1.0",
    "author": "rams",
    "type": "widget",
    "capabilities": ["dankbar-widget", "control-center"],
    "component": "./VpnControlWidget.qml",
    "icon": "vpn_lock",
    "settings": "./VpnControlSettings.qml",
    "requires_dms": ">=1.6.0",
    "dependencies": ["networkmanager"],
    "permissions": ["settings_read", "settings_write", "network"]
}
